<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Flux.Ui.Controls">

    <!-- ThemeDictionaries retint live from ElementTheme, so no WPF-style token swapping is needed. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EEF1F7"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9BA6B8"/>
            <SolidColorBrush x:Key="FluxBorderBrush" Color="#2A3140"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#181C27"/>
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1F2434"/>
            <!-- Disabled recedes toward the surface behind it, which an opacity fade cannot do: that
                 darkens on a dark bar and lightens on a light one, so on one of them it vanishes. -->
            <SolidColorBrush x:Key="DisabledFillBrush" Color="#171B25"/>
            <SolidColorBrush x:Key="DisabledBorderBrush" Color="#232A38"/>
            <SolidColorBrush x:Key="HoverOverlayBrush" Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="HoverOverlayStrongBrush" Color="#22FFFFFF"/>
            <SolidColorBrush x:Key="AltRowBrush" Color="#0DFFFFFF"/>
            <SolidColorBrush x:Key="CaptionGlyphBrush" Color="#D6DAE3"/>
            <!-- ContentDialog retints through its own keys; a flat top overlay makes the card one surface. -->
            <StaticResource x:Key="ContentDialogBackground" ResourceKey="SurfaceBrush"/>
            <StaticResource x:Key="ContentDialogForeground" ResourceKey="TextPrimaryBrush"/>
            <StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="FluxBorderBrush"/>
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="Transparent"/>
            <!-- Setup steps read as quiet text links, not system-blue hyperlinks. -->
            <StaticResource x:Key="HyperlinkButtonForeground" ResourceKey="TextSecondaryBrush"/>
            <StaticResource x:Key="HyperlinkButtonForegroundPointerOver" ResourceKey="TextPrimaryBrush"/>
            <StaticResource x:Key="HyperlinkButtonForegroundPressed" ResourceKey="TextSecondaryBrush"/>
            <x:Double x:Key="AmbientOpacity">1</x:Double>
            <LinearGradientBrush x:Key="BgBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0C0E14" Offset="0"/>
                <GradientStop Color="#12151F" Offset="0.55"/>
                <GradientStop Color="#161A27" Offset="1"/>
            </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#141821"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A6473"/>
            <SolidColorBrush x:Key="FluxBorderBrush" Color="#DCE1EA"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#EEF1F6"/>
            <SolidColorBrush x:Key="DisabledFillBrush" Color="#DDE2EC"/>
            <SolidColorBrush x:Key="DisabledBorderBrush" Color="#CDD4E1"/>
            <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0F000000"/>
            <SolidColorBrush x:Key="HoverOverlayStrongBrush" Color="#1F000000"/>
            <SolidColorBrush x:Key="AltRowBrush" Color="#08000000"/>
            <SolidColorBrush x:Key="CaptionGlyphBrush" Color="#2A3140"/>
            <StaticResource x:Key="ContentDialogBackground" ResourceKey="SurfaceBrush"/>
            <StaticResource x:Key="ContentDialogForeground" ResourceKey="TextPrimaryBrush"/>
            <StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="FluxBorderBrush"/>
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="Transparent"/>
            <!-- Setup steps read as quiet text links, not system-blue hyperlinks. -->
            <StaticResource x:Key="HyperlinkButtonForeground" ResourceKey="TextSecondaryBrush"/>
            <StaticResource x:Key="HyperlinkButtonForegroundPointerOver" ResourceKey="TextPrimaryBrush"/>
            <StaticResource x:Key="HyperlinkButtonForegroundPressed" ResourceKey="TextSecondaryBrush"/>
            <x:Double x:Key="AmbientOpacity">0.5</x:Double>
            <LinearGradientBrush x:Key="BgBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F7F9FC" Offset="0"/>
                <GradientStop Color="#EEF1F7" Offset="0.55"/>
                <GradientStop Color="#E8ECF4" Offset="1"/>
            </LinearGradientBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Invariant brand + status colours, identical in both themes. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF5C6C"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#38D39F"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F0A93B"/>
    <SolidColorBrush x:Key="WarningTintBrush" Color="#26F0A93B"/>
    <SolidColorBrush x:Key="DangerSelectionBrush" Color="#33FF5C6C"/>

    <!-- Stock controls recolour through named lightweight-styling brushes, not a retemplate. -->
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#7C5CFF"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#8E71FF"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#6A4AE0"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#7C5CFF"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#8E71FF"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#6A4AE0"/>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0"/>
        <GradientStop Color="#7C5CFF" Offset="0.5"/>
        <GradientStop Color="#C13BFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientHorizontal" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3B82F6" Offset="0"/>
        <GradientStop Color="#7C5CFF" Offset="0.5"/>
        <GradientStop Color="#C13BFF" Offset="1"/>
    </LinearGradientBrush>

    <x:Double x:Key="ControlHeight">40</x:Double>
    <x:Double x:Key="CtaHeight">46</x:Double>

    <!-- Dialogs size to their content and draw their own buttons, so the stock floor and rule go. -->
    <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
    <Thickness x:Key="ContentDialogSeparatorThickness">0</Thickness>

    <!-- The scrim behind a dialog: the base brush every light-dismiss overlay aliases. Theme-invariant
         because the hosting popup resolves outside the window's ElementTheme. -->
    <SolidColorBrush x:Key="SystemControlPageBackgroundMediumAltMediumBrush" Color="#4D000000"/>

    <Style x:Key="HeadingText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="SubtleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
    </Style>

    <!-- WinUI has no template triggers, so the WPF hover/press MultiTriggers become VisualStates. -->
    <Style x:Key="FluxButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Border x:Name="Bd" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Border x:Name="Overlay" CornerRadius="10" Background="#FFFFFF" Opacity="0"/>
                        <ContentPresenter x:Name="Label"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Overlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.10" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Overlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.06" Duration="0:0:0.06"/>
                                        <DoubleAnimation Storyboard.TargetName="Scale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.97" Duration="0:0:0.06"/>
                                        <DoubleAnimation Storyboard.TargetName="Scale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.97" Duration="0:0:0.06"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <!-- A flat fill of its own, not a fade: the fade moved with whatever
                                         was behind the button, so on a light bar a disabled secondary
                                         button came out the same shade as an enabled one. -->
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bd"
                                                                       Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource DisabledFillBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bd"
                                                                       Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource DisabledBorderBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bd"
                                                                       Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="1"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Label"
                                                                       Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextSecondaryBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FluxButtonBase}">
        <!-- The call to action is the diagonal gradient at the taller CTA metric, as in WPF; the
             horizontal variant belongs to the tab pill and the brand wordmark. -->
        <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="26,0"/>
        <Setter Property="MinHeight" Value="{StaticResource CtaHeight}"/>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource FluxButtonBase}">
        <Setter Property="Background" Value="{ThemeResource SurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource FluxBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource FluxButtonBase}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource FluxBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="DialogHintText" TargetType="TextBlock" BasedOn="{StaticResource SubtleText}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="2,4,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Red text at rest, solid red with white text on hover. -->
    <Style x:Key="DangerGhostButton" TargetType="Button">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Fill" CornerRadius="10" Background="{StaticResource DangerBrush}" Opacity="0"/>
                        <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                   Margin="{TemplateBinding Padding}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource DangerBrush}"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.15"/>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Txt"
                                                                       Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="White"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.85" Duration="0"/>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Txt"
                                                                       Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Txt"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.45" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Only the text state: the checked pill itself is drawn behind the labels by SlidingTabBar. -->
    <Style x:Key="TabRadio" TargetType="RadioButton">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- Two state groups must never write the same property: leaving PointerOver clears
                         its value and takes the Checked one with it. Hover owns a layer, CheckStates the
                         label; CheckStates hides that layer so only an unchecked tab shows hover. -->
                    <Grid Background="Transparent">
                        <Border x:Name="Hover" CornerRadius="9" Background="Transparent"/>
                        <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" Margin="16,9"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Hover"
                                                                       Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource HoverOverlayBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Txt"
                                                                       Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextSecondaryBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Txt"
                                                                       Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The mode segments: same pill as the tabs, sized to share the strip equally. -->
    <Style x:Key="SegmentToggle" TargetType="RadioButton" BasedOn="{StaticResource TabRadio}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- Resting look only; WinUI drives hover and focus from its own lightweight-styling resources. -->
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{ThemeResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource FluxBorderBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{ThemeResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource FluxBorderBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
    </Style>

    <Style TargetType="ToggleSwitch">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="BrandTitle" TargetType="TextBlock" BasedOn="{StaticResource DisplayText}">
        <Setter Property="FontSize" Value="46"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource AccentGradientHorizontal}"/>
    </Style>

    <!-- Title-bar glyph button: the native caption buttons own the right edge, these sit beside them. -->
    <Style x:Key="CaptionIconButton" TargetType="Button">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- States carry instant values and the transitions time them, so the motion gate
                         can strip the transitions and leave the look intact. -->
                    <Grid controls:Motion.GateTransitions="True">
                        <Border x:Name="Bd" CornerRadius="6" Opacity="0"
                                Background="{ThemeResource HoverOverlayStrongBrush}"/>
                        <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.12"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Bd.Opacity" Value="1"/>
                                        <Setter Target="Glyph.Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Bd.Opacity" Value="1"/>
                                        <Setter Target="Glyph.Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Glyph.Opacity" Value="0.4"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
