<local:FluxDialog
    x:Class="Flux.Ui.Views.MessageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Flux.Ui.Views"
    Opened="OnOpened">

    <local:FluxDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">360</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">460</x:Double>
    </local:FluxDialog.Resources>

    <StackPanel>
        <TextBlock x:Name="MessageText" Style="{StaticResource SubtleText}" FontSize="13.5"
                   TextWrapping="Wrap" LineHeight="20"/>
        <!-- Local metrics on the confirm button: its style is swapped per dialog (Primary/Danger),
             and Primary's taller CTA metric would otherwise make the pair visibly unequal. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,24,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" MinWidth="100" Click="OnCancel"/>
            <Button x:Name="ConfirmButton" MinWidth="100" Click="OnConfirm"
                    MinHeight="{StaticResource ControlHeight}" FontSize="14" Padding="18,0"/>
        </StackPanel>
    </StackPanel>
</local:FluxDialog>
