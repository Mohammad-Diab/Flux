<Window x:Class="Flux.Ui.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Opacity="0"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">
    <Border x:Name="Root" Style="{StaticResource Card}" Padding="26" CornerRadius="14"
            MinWidth="360" MaxWidth="460" Margin="34" RenderTransformOrigin="0.5,0.5"
            MouseLeftButtonDown="OnDragMove"
            Effect="{Binding AnimationsEnabled, Source={StaticResource MotionSettings}, Converter={StaticResource EffectWhenEnabled}, ConverterParameter={StaticResource DialogShadow}}">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale"/>
        </Border.RenderTransform>
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource HeadingText}"/>
            <TextBlock x:Name="MessageText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13.5"
                       TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}"
                        MinWidth="100" MinHeight="42" Margin="0,0,10,0" Click="OnCancel"/>
                <Button x:Name="ConfirmButton" MinWidth="100" MinHeight="42" IsDefault="True" Click="OnConfirm"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
