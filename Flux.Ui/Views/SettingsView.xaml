<UserControl
    x:Class="Flux.Ui.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Flux.Ui.Controls">

    <StackPanel Margin="24,8,24,24" Spacing="20">
        <TextBlock Text="Settings" Style="{StaticResource HeadingText}"/>

        <StackPanel Spacing="8">
            <TextBlock Text="APPEARANCE" Style="{StaticResource SubtleText}" FontSize="11" FontWeight="SemiBold"/>
            <Border Style="{StaticResource Card}" Padding="4" HorizontalAlignment="Left" CornerRadius="11">
                <controls:SlidingTabBar Stretch="True" PillCornerRadius="7" Width="330">
                    <RadioButton Content="System" GroupName="Theme" Style="{StaticResource SegmentToggle}"
                                 IsChecked="{x:Bind Vm.IsSystem, Mode=TwoWay}"/>
                    <RadioButton Content="Light" GroupName="Theme" Style="{StaticResource SegmentToggle}"
                                 IsChecked="{x:Bind Vm.IsLight, Mode=TwoWay}"/>
                    <RadioButton Content="Dark" GroupName="Theme" Style="{StaticResource SegmentToggle}"
                                 IsChecked="{x:Bind Vm.IsDark, Mode=TwoWay}"/>
                </controls:SlidingTabBar>
            </Border>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock Text="PERFORMANCE" Style="{StaticResource SubtleText}" FontSize="11" FontWeight="SemiBold"/>
            <ToggleSwitch Header="Performance mode" OnContent="On" OffContent="Off"
                          IsOn="{x:Bind Vm.PerformanceMode, Mode=TwoWay}"/>
            <TextBlock Text="Skips animations and expensive visual effects."
                       Style="{StaticResource SubtleText}" FontSize="12"/>
        </StackPanel>
    </StackPanel>
</UserControl>
