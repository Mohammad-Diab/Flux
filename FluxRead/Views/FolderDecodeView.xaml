<UserControl x:Class="FluxRead.Views.FolderDecodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Folder decode" Style="{StaticResource HeadingText}"/>
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding FramesFolder, Mode=OneWay}" IsReadOnly="True"/>
                <Button Grid.Column="1" Content="Pick frames folder…" Command="{Binding PickAndDecodeCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="6">
        <DataGrid ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  FontSize="12" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Frame" Binding="{Binding FileName}" Width="160"/>
                <DataGridTextColumn Header="Id" Binding="{Binding FrameId}" Width="50"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Success}" Value="False">
                            <Setter Property="Background" Value="{StaticResource DangerSelectionBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
        </Border>

        <!-- Bottom bar: while decoding it is the progress readout (mirrors the mini capture window's
             collapsed row); otherwise the result summary and Save. -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid Visibility="{Binding IsDecoding, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Height="56">
                    <ProgressBar Height="56" Tag="10" Minimum="0" Maximum="1" Value="{Binding ProgressValue}"
                                 Foreground="#557C5CFF"/>
                    <StackPanel Margin="14,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DecodedCountText}" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ProgressCaption}" Style="{StaticResource SubtleText}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding FailedCountText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Visibility="{Binding FailedCountText, Converter={StaticResource NullToCollapsed}}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource SubtleText}" FontSize="11"/>
                            <TextBlock Text="{Binding SpeedText}" Style="{StaticResource SubtleText}" FontSize="11" Margin="12,0,0,0"/>
                            <TextBlock Text="{Binding EtaText}" Style="{StaticResource SubtleText}" FontSize="11" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Button Grid.Column="1" Content="{Binding PauseLabel}" Command="{Binding TogglePauseCommand}"
                        Style="{StaticResource SecondaryButton}" MinWidth="104" Margin="10,0,0,0"
                        VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelDecodeCommand}"
                        Style="{StaticResource DangerButton}" MinWidth="104" Margin="8,0,0,0"
                        VerticalAlignment="Center"/>
            </Grid>

            <Grid Visibility="{Binding IsDecoding, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource SubtleText}"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}"/>
                    <ProgressBar Height="6" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="{Binding ProgressValue}"
                                 Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Save…" Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButton}" MinWidth="130" Margin="16,0,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
