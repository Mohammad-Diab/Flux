<ui:FluxDialog
    x:Class="FluxRead.Views.ManualResumeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Flux.Ui.Views"
    Opened="OnOpened">

    <ui:FluxDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">440</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">440</x:Double>
    </ui:FluxDialog.Resources>

    <StackPanel>
        <TextBlock x:Name="DetailText" Style="{StaticResource SubtleText}" TextWrapping="Wrap"/>

        <Button x:Name="ContinueButton" Content="Continue" HorizontalAlignment="Stretch" Margin="0,20,0,0"
                Style="{StaticResource PrimaryButton}" Click="OnContinue"/>
        <TextBlock Text="FluxRead captures the frame you've navigated to, then keeps going."
                   Style="{StaticResource DialogHintText}"/>

        <Button Content="Cancel transfer" HorizontalAlignment="Stretch" Margin="0,16,0,0"
                Style="{StaticResource DangerGhostButton}" Click="OnCancel"/>
    </StackPanel>
</ui:FluxDialog>
