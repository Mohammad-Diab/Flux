<ui:FluxDialog
    x:Class="FluxRead.Views.StallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Flux.Ui.Views"
    Title="Transfer needs attention"
    Opened="OnOpened">

    <ui:FluxDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">440</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">440</x:Double>
    </ui:FluxDialog.Resources>

    <StackPanel>
        <TextBlock x:Name="DetailText" Style="{StaticResource SubtleText}" TextWrapping="Wrap"/>

        <Button x:Name="RetryButton" Content="Try again" HorizontalAlignment="Stretch" Margin="0,20,0,0"
                Style="{StaticResource PrimaryButton}" Click="OnRetry"/>
        <TextBlock Text="Keep going — it recalibrates automatically on each try." Style="{StaticResource DialogHintText}"/>

        <Button x:Name="ManualButton" HorizontalAlignment="Stretch" Margin="0,14,0,0"
                Style="{StaticResource SecondaryButton}" Click="OnManual"/>
        <TextBlock x:Name="ManualHint" Style="{StaticResource DialogHintText}"/>

        <Button Content="Stop transfer" HorizontalAlignment="Stretch" Margin="0,18,0,0"
                Style="{StaticResource DangerButton}" Click="OnStop"/>
        <TextBlock Text="Received frames are kept — resume later from the Received tab." Style="{StaticResource DialogHintText}"/>
    </StackPanel>
</ui:FluxDialog>
