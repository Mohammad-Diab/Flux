<Window x:Class="FluxRead.Views.MiniCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Flux.Ui.Views;assembly=Flux.Ui"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FluxRead — Capturing"
        Icon="/Assets/AppIcon.ico"
        Width="400" Height="372" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="True"
        Style="{StaticResource FluxWindow}"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="MiniIconButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource CaptionGlyphBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlayBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header: brand + state, then collapse/expand and close. Draggable, so the buttons opt back
             into hit-testing. -->
        <Border DockPanel.Dock="Top" Height="48" Background="Transparent">
            <Grid Margin="14,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:BrandMark Width="20" Height="20"/>
                    <TextBlock Text="FluxRead" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding StateText}" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="CollapseButton" Style="{StaticResource MiniIconButton}" Click="OnToggleSize"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path x:Name="CollapseIcon" StrokeThickness="1.6" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource MiniIconButton}" Margin="2,0,0,0"
                            ToolTip="Stop and close" Click="OnClose"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M1,1 L11,11 M11,1 L1,11" StrokeThickness="1.6" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <!-- Expanded: full status + last-frame preview. -->
            <Grid x:Name="ExpandedBody" Margin="18,2,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ReceivedCountText}" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource SubtleText}"
                                   VerticalAlignment="Center" Margin="3,0,0,0"/>
                        <TextBlock Text="{Binding RetryText}" Style="{StaticResource SubtleText}"
                                   Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Visibility="{Binding RetryText, Converter={StaticResource NullToCollapsed}}"/>
                        <TextBlock Text="{Binding MissingCountText}" Style="{StaticResource SubtleText}"
                                   Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Visibility="{Binding MissingCountText, Converter={StaticResource NullToCollapsed}}"/>
                    </StackPanel>
                    <ProgressBar Height="6" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="{Binding TransferProgress}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource SubtleText}" FontSize="11"/>
                        <TextBlock Text="{Binding SpeedText}" Style="{StaticResource SubtleText}" FontSize="11" Margin="14,0,0,0"/>
                        <TextBlock Text="{Binding EtaText}" Style="{StaticResource SubtleText}" FontSize="11" Margin="14,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding QualityText}" Style="{StaticResource SubtleText}" FontSize="11"
                               Margin="0,6,0,0" TextWrapping="Wrap"
                               Visibility="{Binding QualityText, Converter={StaticResource NullToCollapsed}}"/>
                    <ProgressBar Height="6" Margin="0,10,0,0" Minimum="0" Maximum="1" Value="{Binding DecompressProgress}"
                                 Visibility="{Binding IsDecompressing, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Border Style="{StaticResource Card}" Padding="6">
                        <Image Source="{Binding LastThumbnail}" Stretch="Uniform"/>
                    </Border>
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="12"
                            Visibility="{Binding IsRecovering, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding RecoveryTitle}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding RecoveryHint}"
                                       Style="{StaticResource SubtleText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"
                                          Visibility="{Binding MissingFramesText, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock Text="{Binding MissingFramesText}" FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="{Binding PauseLabel}" Style="{StaticResource SecondaryButton}"
                            MinWidth="96" Click="OnPauseToggle"/>
                    <Button Content="Cancel" Style="{StaticResource DangerButton}" MinWidth="96" Margin="10,0,0,0"
                            Click="OnCancel"/>
                </StackPanel>
            </Grid>

            <!-- Collapsed: one row — a tall progress bar with two lines of stats, then pause and stop. -->
            <Grid x:Name="CollapsedBody" Margin="16,2,16,16" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Height="56">
                    <ProgressBar Height="56" Minimum="0" Maximum="1" Value="{Binding TransferProgress}"
                                 Foreground="#557C5CFF"/>
                    <StackPanel Margin="14,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ReceivedCountText}" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource SubtleText}"
                                       VerticalAlignment="Center" Margin="3,0,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding RetryText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Visibility="{Binding RetryText, Converter={StaticResource NullToCollapsed}}"/>
                            <TextBlock Text="{Binding MissingCountText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Visibility="{Binding MissingCountText, Converter={StaticResource NullToCollapsed}}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource SubtleText}" FontSize="11"/>
                            <TextBlock Text="{Binding SpeedText}" Style="{StaticResource SubtleText}" FontSize="11" Margin="12,0,0,0"/>
                            <TextBlock Text="{Binding EtaText}" Style="{StaticResource SubtleText}" FontSize="11" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Button Grid.Column="1" Style="{StaticResource MiniIconButton}" Width="44" Height="44"
                        Margin="10,0,0,0" Click="OnPauseToggle" ToolTip="{Binding PauseLabel}">
                    <Path x:Name="PauseIcon"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource MiniIconButton}" Width="44" Height="44"
                        Margin="8,0,0,0" Foreground="{StaticResource DangerBrush}" Click="OnCancel" ToolTip="Stop">
                    <Path Data="M1,1 L11,1 L11,11 L1,11 Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
