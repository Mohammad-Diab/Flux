<ui:FluxDialog
    x:Class="FluxRead.Views.FramePickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Flux.Ui.Views"
    Title="Multiple frames found">

    <ui:FluxDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">360</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
    </ui:FluxDialog.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Text="Pick the one to capture." Style="{StaticResource SubtleText}" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Candidates">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Tag="{Binding Index}" Click="OnPick" Style="{StaticResource SecondaryButton}"
                                MinHeight="0" Padding="8" Margin="0,0,12,0">
                            <StackPanel Width="220">
                                <Border Background="{ThemeResource SurfaceAltBrush}" CornerRadius="6" Padding="4">
                                    <Image Source="{Binding Thumbnail}" MaxHeight="150" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                           FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Cancel" HorizontalAlignment="Right" Margin="0,16,0,0"
                Style="{StaticResource SecondaryButton}" MinWidth="96" Click="OnCancel"/>
    </Grid>
</ui:FluxDialog>
