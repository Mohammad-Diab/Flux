<ui:FluxDialog
    x:Class="FluxRead.WinUI.Views.StallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Flux.Ui.WinUI.Views"
    Title="No new frames arriving"
    Opened="OnOpened">

    <ui:FluxDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">440</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">440</x:Double>
    </ui:FluxDialog.Resources>

    <StackPanel>
        <TextBlock x:Name="DetailText" Style="{StaticResource SubtleText}" TextWrapping="Wrap"/>

        <Button x:Name="RetryButton" Content="Retry" HorizontalAlignment="Stretch" Margin="0,20,0,0"
                Style="{StaticResource PrimaryButton}" Click="OnRetry"/>
        <TextBlock Text="Click again and keep going — for a brief hiccup." Style="{StaticResource DialogHintText}"/>

        <Button Content="Recalibrate Next" HorizontalAlignment="Stretch" Margin="0,14,0,0"
                Style="{StaticResource SecondaryButton}" Click="OnRecalibrateNext"/>
        <TextBlock Text="Re-find the Next button (its click point may be off)." Style="{StaticResource DialogHintText}"/>

        <Button Content="Adjust region" HorizontalAlignment="Stretch" Margin="0,14,0,0"
                Style="{StaticResource SecondaryButton}" Click="OnAdjustRegion"/>
        <TextBlock Text="Re-detect the frame area (if the sender window moved)." Style="{StaticResource DialogHintText}"/>

        <Button Content="Cancel transfer" HorizontalAlignment="Stretch" Margin="0,18,0,0"
                Style="{StaticResource DangerGhostButton}" Click="OnCancel"/>
    </StackPanel>
</ui:FluxDialog>
