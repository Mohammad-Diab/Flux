<local:FluxDialog
    x:Class="FluxRead.WinUI.Views.ResumeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluxRead.WinUI.Views"
    Title="Resume this reception?"
    Opened="OnOpened">

    <local:FluxDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">460</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">460</x:Double>
    </local:FluxDialog.Resources>

    <StackPanel>
        <TextBlock x:Name="DetailText" Style="{StaticResource SubtleText}" TextWrapping="Wrap"/>

        <Button x:Name="AutomaticButton" Content="Continue automatically" HorizontalAlignment="Stretch"
                Margin="0,20,0,0" Style="{StaticResource PrimaryButton}" Click="OnAutomatic"/>
        <TextBlock x:Name="AutomaticHint" Style="{StaticResource DialogHintText}"/>

        <Button Content="I'll navigate the sender myself" HorizontalAlignment="Stretch" Margin="0,14,0,0"
                Style="{StaticResource SecondaryButton}" Click="OnManual"/>
        <TextBlock x:Name="ManualHint" Style="{StaticResource DialogHintText}"/>

        <Button Content="Start over" HorizontalAlignment="Stretch" Margin="0,14,0,0"
                Style="{StaticResource SecondaryButton}" Click="OnStartOver"/>
        <TextBlock x:Name="StartOverHint" Style="{StaticResource DialogHintText}"/>

        <Button Content="Cancel" HorizontalAlignment="Stretch" Margin="0,18,0,0"
                Style="{StaticResource DangerGhostButton}" Click="OnCancel"/>
    </StackPanel>
</local:FluxDialog>
