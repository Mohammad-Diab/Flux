<UserControl
    x:Class="FluxRead.WinUI.Views.LiveCaptureView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Flux.Ui.WinUI.Controls">

    <Grid Margin="24,8,24,24" RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Live optical capture" Style="{StaticResource HeadingText}"/>
            <TextBlock Text="Select the on-screen region, teach the Next button, then start the transfer."
                       Style="{StaticResource SubtleText}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="380,*">

            <!-- Left: control panel -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                <Grid RowDefinitions="*,Auto,Auto">
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="SETUP" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextSecondaryBrush}" Margin="2,0,0,10"/>

                            <Button Content="Auto-detect frame &amp; Next" HorizontalAlignment="Stretch"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="OnDetectRegion" IsEnabled="{x:Bind Vm.CanConfigure, Mode=OneWay}"/>
                            <HyperlinkButton Content="Select region manually" Margin="-10,10,0,0" Padding="10,6"
                                             FontSize="13"
                                             Click="OnSelectRegionManual" IsEnabled="{x:Bind Vm.CanConfigure, Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind Vm.RegionText, Mode=OneWay}" Style="{StaticResource SubtleText}"
                                       FontSize="12" Margin="2,4,0,0" TextWrapping="Wrap"/>

                            <TextBlock Text="Region preview (live)" Style="{StaticResource SubtleText}" Margin="0,10,0,0"
                                       Visibility="{x:Bind Shown(Vm.RegionPreview), Mode=OneWay}"/>
                            <Border Background="{ThemeResource SurfaceAltBrush}" CornerRadius="8" Padding="6" Margin="0,6,0,0"
                                    Visibility="{x:Bind Shown(Vm.RegionPreview), Mode=OneWay}">
                                <Image Source="{x:Bind Vm.RegionPreview, Mode=OneWay}" MaxHeight="140" Stretch="Uniform"/>
                            </Border>

                            <HyperlinkButton Content="Calibrate Next (F8)" Margin="-10,14,0,0" Padding="10,6"
                                             FontSize="13"
                                             Click="OnCalibrate" IsEnabled="{x:Bind Vm.CanConfigure, Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind Vm.CalibrationText, Mode=OneWay}" Style="{StaticResource SubtleText}"
                                       FontSize="12" Margin="2,4,0,0" TextWrapping="Wrap"/>

                            <TextBlock Text="Next button" Style="{StaticResource SubtleText}" Margin="0,10,0,0"
                                       Visibility="{x:Bind Shown(Vm.CalibrationPreview), Mode=OneWay}"/>
                            <Border Background="{ThemeResource SurfaceAltBrush}" CornerRadius="8" Padding="6" Margin="0,6,0,0"
                                    Visibility="{x:Bind Shown(Vm.CalibrationPreview), Mode=OneWay}">
                                <Image Source="{x:Bind Vm.CalibrationPreview, Mode=OneWay}" MaxHeight="70" Stretch="Uniform"/>
                            </Border>

                            <TextBlock Text="Last frame" Style="{StaticResource SubtleText}" Margin="0,14,0,0"
                                       Visibility="{x:Bind Shown(Vm.LastThumbnail), Mode=OneWay}"/>
                            <Border Background="{ThemeResource SurfaceAltBrush}" CornerRadius="8" Padding="6" Margin="0,6,0,0"
                                    Visibility="{x:Bind Shown(Vm.LastThumbnail), Mode=OneWay}">
                                <Image Source="{x:Bind Vm.LastThumbnail, Mode=OneWay}" MaxHeight="140" Stretch="Uniform"/>
                            </Border>

                            <TextBlock Text="{x:Bind Vm.RecoveryHint, Mode=OneWay}" Style="{StaticResource SubtleText}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"
                                       Visibility="{x:Bind Vm.IsRecovering, Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind Vm.MissingFramesText, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,6,0,0" Foreground="{StaticResource DangerBrush}"
                                       Visibility="{x:Bind Vm.IsRecovering, Mode=OneWay}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" BorderBrush="{ThemeResource FluxBorderBrush}" BorderThickness="0,1,0,0"
                            Padding="0,14,0,0" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{x:Bind Vm.StateText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Spacing="8">
                                <TextBlock Text="{x:Bind Vm.ReceivedCountText, Mode=OneWay}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Bind Vm.ProgressText, Mode=OneWay}" Style="{StaticResource SubtleText}" FontSize="12"/>
                                <TextBlock Text="{x:Bind Vm.RetryText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="{x:Bind Vm.MissingCountText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource DangerBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Spacing="12">
                                <TextBlock Text="{x:Bind Vm.ElapsedText, Mode=OneWay}" Style="{StaticResource SubtleText}" FontSize="11"/>
                                <TextBlock Text="{x:Bind Vm.SpeedText, Mode=OneWay}" Style="{StaticResource SubtleText}" FontSize="11"/>
                                <TextBlock Text="{x:Bind Vm.EtaText, Mode=OneWay}" Style="{StaticResource SubtleText}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Button Content="Start transfer" HorizontalAlignment="Stretch"
                                Style="{StaticResource PrimaryButton}" Click="OnStart"
                                IsEnabled="{x:Bind Vm.CanStart, Mode=OneWay}"
                                Visibility="{x:Bind Vm.CanConfigure, Mode=OneWay}"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8"
                              Visibility="{x:Bind Vm.IsRunning, Mode=OneWay}">
                            <Button Grid.Column="0" Content="{x:Bind Vm.PauseLabel, Mode=OneWay}"
                                    HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButton}"
                                    Click="OnTogglePause"/>
                            <Button Grid.Column="1" Content="Cancel" HorizontalAlignment="Stretch"
                                    Style="{StaticResource DangerButton}" Click="OnCancel"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right: activity log -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0" Padding="6">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360" Margin="20"
                                Visibility="{x:Bind Hidden(Vm.HasLog), Mode=OneWay}">
                        <TextBlock Text="Activity log" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Style="{StaticResource SubtleText}" TextAlignment="Center" Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Text="Once you select a region, calibrate the Next button, and press Start, each decoded frame, re-click, stall, and the final result will appear here."/>
                    </StackPanel>
                    <ListView x:Name="LogList" ItemsSource="{x:Bind Vm.Log, Mode=OneWay}" SelectionMode="None"
                              FontFamily="Consolas" FontSize="11">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="8,2"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
