<Window
    x:Class="FluxRead.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluxRead.WinUI.Controls">

    <Grid Background="{ThemeResource BgBrush}" RowDefinitions="48,Auto,*">

        <!-- Custom title bar: WinUI extends content into it and takes a drag region element, which
             replaces WPF's WindowChrome + IsHitTestVisibleInChrome. -->
        <Grid x:Name="TitleBarStrip" Grid.Row="0" Padding="16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AccentGradient}"/>
                <TextBlock Text="FluxRead" Style="{StaticResource BrandTitle}" FontSize="13"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Optical receiver · WinUI" FontSize="12"
                           Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <!-- Clear of the native caption buttons, which own the right edge of the drag region. -->
            <Button x:Name="ThemeToggle" Content="Theme" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,148,0"
                    MinHeight="30" Padding="12,0" FontSize="12" Click="OnToggleTheme"/>
        </Grid>

        <Border Grid.Row="1" Padding="24,8,24,2">
            <controls:SlidingTabBar HorizontalAlignment="Left">
                <RadioButton x:Name="LiveTab" Content="Live optical capture" GroupName="Mode"
                             Style="{StaticResource TabRadio}" Checked="OnTabChanged"/>
                <RadioButton x:Name="FolderTab" Content="Folder decode" GroupName="Mode"
                             Style="{StaticResource TabRadio}" IsChecked="True" Checked="OnTabChanged"/>
                <RadioButton x:Name="ReceivedTab" Content="Received" GroupName="Mode"
                             Style="{StaticResource TabRadio}" Checked="OnTabChanged"/>
            </controls:SlidingTabBar>
        </Border>

        <ContentControl x:Name="ModeHost" Grid.Row="2"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</Window>
