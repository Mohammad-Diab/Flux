<Window
    x:Class="FluxRead.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:FluxRead.Services"
    xmlns:controls="using:FluxRead.WinUI.Controls">

    <Grid Background="{ThemeResource BgBrush}" RowDefinitions="48,*">

        <!-- Custom title bar: WinUI extends content into it and takes a drag region element, which
             replaces WPF's WindowChrome + IsHitTestVisibleInChrome. -->
        <Grid x:Name="TitleBarStrip" Grid.Row="0" Padding="16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AccentGradient}"/>
                <TextBlock Text="FluxRead" FontSize="13" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Optical receiver · WinUI" FontSize="12"
                           Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <!-- Clear of the native caption buttons, which own the right edge of the drag region. -->
            <Button x:Name="ThemeToggle" Content="Theme" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,148,0"
                    MinHeight="30" Padding="12,0" FontSize="12" Click="OnToggleTheme"/>
        </Grid>

        <Grid Grid.Row="1" Margin="24,8,24,24" RowDefinitions="Auto,Auto,*,Auto">

            <TextBlock Grid.Row="0" Text="Folder decode" Style="{StaticResource HeadingText}"/>

            <Grid Grid.Row="1" Margin="0,16,0,0" ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{x:Bind Vm.FramesFolder, Mode=OneWay}" IsReadOnly="True"
                         MinHeight="{StaticResource ControlHeight}" CornerRadius="8"/>
                <Button Grid.Column="1" Content="Pick frames folder…" Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Command="{x:Bind Vm.PickAndDecodeCommand}"
                        IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}"/>
            </Grid>

            <!-- Results table: WinUI 3 has no first-party DataGrid, and the read-only 4-column grid
                 needs none — a header row over a ListView matches it. -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="6">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" Padding="10,8" ColumnDefinitions="160,50,120,*">
                        <TextBlock Grid.Column="0" Text="Frame" Style="{StaticResource SubtleText}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="Id" Style="{StaticResource SubtleText}" FontSize="12"/>
                        <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource SubtleText}" FontSize="12"/>
                        <TextBlock Grid.Column="3" Text="Detail" Style="{StaticResource SubtleText}" FontSize="12"/>
                    </Grid>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Rows, Mode=OneWay}"
                              SelectionMode="None" Padding="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:FrameRow">
                                <Grid Padding="10,7" ColumnDefinitions="160,50,120,*">
                                    <TextBlock Grid.Column="0" Text="{x:Bind FileName}" FontSize="12"
                                               Foreground="{ThemeResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind FrameId}" FontSize="12"
                                               Foreground="{ThemeResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Status}" FontSize="12"
                                               Foreground="{ThemeResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind Detail}" FontSize="12"
                                               Foreground="{ThemeResource TextPrimaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Bottom bar swaps between the decoding readout and the idle summary, as in the WPF app. -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid Visibility="{x:Bind Vm.IsDecoding, Mode=OneWay}" ColumnDefinitions="*,Auto,Auto">
                    <controls:ReadoutBar Grid.Column="0" Height="56" BarCornerRadius="10"
                                        Fraction="{x:Bind Vm.Fraction, Mode=OneWay}"
                                        TrackBrush="{ThemeResource SurfaceAltBrush}"
                                        FillBrush="#557C5CFF">
                        <controls:ReadoutBar.Readout>
                            <StackPanel Margin="14,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind Vm.DecodedCountText, Mode=OneWay}" FontSize="16"
                                               FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind Vm.ProgressCaption, Mode=OneWay}"
                                               Style="{StaticResource SubtleText}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind Vm.FailedCountText, Mode=OneWay}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0" Spacing="12">
                                    <TextBlock Text="{x:Bind Vm.ElapsedText, Mode=OneWay}" Style="{StaticResource SubtleText}" FontSize="11"/>
                                    <TextBlock Text="{x:Bind Vm.SpeedText, Mode=OneWay}" Style="{StaticResource SubtleText}" FontSize="11"/>
                                    <TextBlock Text="{x:Bind Vm.EtaText, Mode=OneWay}" Style="{StaticResource SubtleText}" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </controls:ReadoutBar.Readout>
                    </controls:ReadoutBar>
                    <Button Grid.Column="1" Content="{x:Bind Vm.PauseLabel, Mode=OneWay}" MinWidth="104"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButton}" Command="{x:Bind Vm.TogglePauseCommand}"/>
                    <Button Grid.Column="2" Content="Cancel" MinWidth="104" Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource DangerButton}" Command="{x:Bind Vm.CancelDecodeCommand}"/>
                </Grid>

                <Grid Visibility="{x:Bind Vm.IsIdle, Mode=OneWay}" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" Style="{StaticResource SubtleText}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Save…" MinWidth="130" Margin="16,0,0,0"
                            Style="{StaticResource PrimaryButton}" Command="{x:Bind Vm.SaveCommand}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
