<UserControl
    x:Class="FluxCast.Views.SizeWarningBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A pill rather than a bar: the warning is about the frame being short of room, so it must not
         take any. It sits in the title bar beside the caption buttons — chrome the receiver never
         captures. The whole pill is the button — a 22 px circle is a small target for something the
         user is meant to notice and open. Click, not hover: the pointer passes through this corner on
         its way to the caption buttons. -->
    <Button x:Name="WarningButton" Padding="0" MinWidth="0" MinHeight="0"
            BorderThickness="0" Background="Transparent"
            AutomationProperties.Name="Window size is too small"
            ToolTipService.ToolTip="The frame is below native size — open for detail">
        <!-- The button is only the hit target; the two islands below carry every mark. -->
        <Button.Resources>
            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
        </Button.Resources>
        <!-- One island cut in two. The label's right edge is concave, struck by the same circle
             the mark is, so the pair reads as a single shape pulled apart rather than a caption
             next to a badge. A corner radius cannot bend inwards, so the outline is a geometry
             built to the label's width in code. -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid x:Name="Capsule" Height="28" VerticalAlignment="Center" SizeChanged="OnCapsuleResized">
                <!-- Round joins: the horn tips where the straight edges meet the concave arc are
                     acute, and a mitre join throws a spike past each tip. -->
                <Path x:Name="Shape" Fill="{StaticResource DangerTintBrush}"
                      Stroke="{StaticResource DangerBrush}" StrokeThickness="1"
                      StrokeLineJoin="Round"/>
                <TextBlock Text="Window size is too small"
                           VerticalAlignment="Center" Margin="15,0,20,0" FontSize="11"
                           FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
            </Grid>
            <!-- Only the mark beats. The label holds still so it stays readable. -->
            <Border Width="28" Height="28" CornerRadius="14" VerticalAlignment="Center"
                    Margin="-4,0,0,0" Background="{StaticResource DangerBrush}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="MarkScale"/>
                </Border.RenderTransform>
                <FontIcon Glyph="&#xE783;" FontSize="15" Foreground="White"/>
            </Border>
        </StackPanel>
        <Button.Flyout>
            <Flyout Placement="Bottom" Opening="OnOpening">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}"/>
                        <Setter Property="BorderBrush" Value="{ThemeResource FluxBorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="12"/>
                        <Setter Property="Padding" Value="18"/>
                        <Setter Property="MaxWidth" Value="400"/>
                    </Style>
                </Flyout.FlyoutPresenterStyle>
                <StackPanel Width="330" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="26" Height="26" CornerRadius="13"
                                Background="{StaticResource DangerBrush}">
                            <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Window is small" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource SubtleText}"
                               Text="The frame is drawn below its native size. Shrinking it blunts the tile edges the receiver reads, so a capture may need more retries or fail outright."/>
                    <!-- The numbers behind the warning, so it is not just an assertion. -->
                    <Border Background="{ThemeResource SurfaceAltBrush}" CornerRadius="8" Padding="11,9">
                        <TextBlock x:Name="Detail" TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                   Foreground="{ThemeResource TextSecondaryBrush}"/>
                    </Border>
                    <Button Content="Got it" Click="OnDismiss" HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryButton}" MinHeight="34" FontSize="13"/>
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
