<UserControl x:Class="FluxCast.Views.RecentCastsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="OverflowMenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlayBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0,16,0,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="26,0,26,14">
            <TextBlock Text="Recent casts" Style="{StaticResource HeadingText}"/>
            <TextBlock Text="Resume a past cast, open its source location, or delete it to free space."
                       Style="{StaticResource SubtleText}" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="42"
                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="No casts yet" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            <TextBlock Text="Cast a file or folder and it'll show up here." Style="{StaticResource SubtleText}"
                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <!-- Cards are inset so their drop shadows have room before the scroll-viewer clip. -->
            <ItemsControl ItemsSource="{Binding Casts}" Margin="24,8,24,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                        Background="{StaticResource SurfaceAltBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TypeGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}"
                                                CornerRadius="5" Padding="7,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SpecText}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding LocationText}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.75"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding LocationText}"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding FramesText}" Style="{StaticResource SubtleText}"/>
                                    <TextBlock Text=" · " Style="{StaticResource SubtleText}"/>
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource SubtleText}"/>
                                    <TextBlock Text=" · " Style="{StaticResource SubtleText}"/>
                                    <TextBlock Text="{Binding DateText}" Style="{StaticResource SubtleText}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Resume" Style="{StaticResource PrimaryButton}"
                                            MinHeight="0" Padding="18,8" FontSize="12.5" Effect="{x:Null}"
                                            Command="{Binding ResumeCommand}" ToolTip="{Binding ResumeTooltip}"/>
                                    <Grid Margin="8,0,0,0">
                                        <Button x:Name="MoreBtn" Style="{StaticResource SecondaryButton}"
                                                MinHeight="0" MinWidth="0" Padding="12,8" Click="ToggleOverflow" ToolTip="More actions">
                                            <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                        </Button>
                                        <Popup StaysOpen="False" AllowsTransparency="True" Placement="Bottom"
                                               HorizontalOffset="-170" VerticalOffset="-6" PlacementTarget="{Binding ElementName=MoreBtn}">
                                            <!-- Margin leaves room inside the transparent popup for the card's drop shadow. -->
                                            <Border Style="{StaticResource Card}" Padding="6" MinWidth="188" Margin="18,14,18,24">
                                                <StackPanel>
                                                    <Button Content="Open location" Style="{StaticResource OverflowMenuButton}"
                                                            Command="{Binding OpenLocationCommand}" Click="CloseOverflow"/>
                                                    <Button Content="Open frames" Style="{StaticResource OverflowMenuButton}"
                                                            Command="{Binding OpenFramesCommand}" Click="CloseOverflow"/>
                                                    <Button Content="Export frames…" Style="{StaticResource OverflowMenuButton}"
                                                            Command="{Binding ExportFramesCommand}" Click="CloseOverflow"/>
                                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="6,5"/>
                                                    <Button Content="Delete" Style="{StaticResource OverflowMenuButton}"
                                                            Foreground="{StaticResource DangerBrush}"
                                                            Command="{Binding DeleteCommand}" Click="CloseOverflow"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="0" Grid.RowSpan="2" Background="#99000000"
                Visibility="{Binding IsExportPromptOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" Padding="28" MaxWidth="440" Margin="32"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ExportPromptTitle}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="The frame PNGs are copied into a subfolder you choose, alongside a manifest with a per-frame checksum."
                               Style="{StaticResource SubtleText}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <CheckBox Content="Compress to a single .7z (maximum compression)"
                              IsChecked="{Binding CompressExport}" Margin="0,18,0,0" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                MinWidth="96" Command="{Binding CancelExportCommand}"/>
                        <Button Content="Export" Style="{StaticResource PrimaryButton}"
                                MinWidth="112" Margin="10,0,0,0" Command="{Binding ConfirmExportCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
