<UserControl
    x:Class="FluxCast.Views.RecentCastsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FluxCast.ViewModels">

    <Grid Margin="0,8,0,20" RowDefinitions="Auto,*">

        <Grid Grid.Row="0" Margin="24,0,24,14" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0">
                <TextBlock Text="Recent casts" Style="{StaticResource HeadingText}"/>
                <TextBlock Text="Resume a past cast, open its source location, or delete it to free space."
                           Style="{StaticResource SubtleText}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    MinHeight="0" MinWidth="0" Padding="12,9" VerticalAlignment="Center"
                    Click="{x:Bind Vm.Refresh}"
                    ToolTipService.ToolTip="Reload the list from disk"
                    AutomationProperties.Name="Refresh">
                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{x:Bind Vm.IsEmpty, Mode=OneWay}">
            <FontIcon Glyph="&#xE81C;" FontSize="42" Foreground="{ThemeResource TextSecondaryBrush}"
                      HorizontalAlignment="Center"/>
            <TextBlock Text="No casts yet" FontSize="16" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            <TextBlock Text="Cast a file or folder and it'll show up here." Style="{StaticResource SubtleText}"
                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{x:Bind Hidden(Vm.IsEmpty), Mode=OneWay}">
            <ItemsControl ItemsSource="{x:Bind Vm.Casts, Mode=OneWay}" Margin="24,0,24,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CastHistoryItemViewModel">
                        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                        Background="{ThemeResource SurfaceAltBrush}" VerticalAlignment="Center">
                                    <Grid>
                                        <Path Data="M1,3 L7,3 L9,6 L17,6 L17,15 L1,15 Z"
                                              Stroke="{ThemeResource TextSecondaryBrush}" StrokeThickness="1.4"
                                              StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="{x:Bind IsFolder}"/>
                                        <Path Data="M3,1 L11,1 L15,5 L15,16 L3,16 Z M11,1 L11,5 L15,5"
                                              Stroke="{ThemeResource TextSecondaryBrush}" StrokeThickness="1.4"
                                              StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="{x:Bind IsFile}"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DisplayName}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,4,0,0" ColumnDefinitions="Auto,*">
                                        <Border Grid.Column="0" Background="{ThemeResource SurfaceAltBrush}"
                                                CornerRadius="5" Padding="7,2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind SpecText}" FontSize="11"
                                                       Foreground="{ThemeResource TextSecondaryBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{x:Bind LocationText}" FontSize="12"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" Opacity="0.75"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind LocationText}"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="0,0,16,0">
                                    <TextBlock Text="{x:Bind FramesText}" Style="{StaticResource SubtleText}"/>
                                    <TextBlock Text=" · " Style="{StaticResource SubtleText}"/>
                                    <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource SubtleText}"/>
                                    <TextBlock Text=" · " Style="{StaticResource SubtleText}"/>
                                    <TextBlock Text="{x:Bind DateText}" Style="{StaticResource SubtleText}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                    <Button Content="Resume" Style="{StaticResource PrimaryButton}"
                                            MinHeight="0" Padding="18,8" FontSize="12.5"
                                            Command="{x:Bind ResumeCommand}"
                                            ToolTipService.ToolTip="{x:Bind ResumeTooltip}"/>
                                    <Button Style="{StaticResource SecondaryButton}" MinHeight="0" MinWidth="0"
                                            Padding="12,8" ToolTipService.ToolTip="More actions"
                                            AutomationProperties.Name="More actions">
                                        <Button.Content>
                                            <FontIcon Glyph="&#xE712;" FontSize="14"/>
                                        </Button.Content>
                                        <Button.Flyout>
                                            <MenuFlyout Placement="Bottom">
                                                <MenuFlyoutItem Text="Open location" Command="{x:Bind OpenLocationCommand}"/>
                                                <MenuFlyoutItem Text="Open frames" Command="{x:Bind OpenFramesCommand}"/>
                                                <MenuFlyoutItem Text="Export frames…" Command="{x:Bind ExportFramesCommand}"/>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem Text="Delete" Command="{x:Bind DeleteCommand}"
                                                                Foreground="{StaticResource DangerBrush}">
                                                    <!-- Same language as DangerGhostButton: red text at rest, solid red under the pointer. -->
                                                    <MenuFlyoutItem.Resources>
                                                        <StaticResource x:Key="MenuFlyoutItemBackgroundPointerOver" ResourceKey="DangerBrush"/>
                                                        <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="White"/>
                                                        <StaticResource x:Key="MenuFlyoutItemBackgroundPressed" ResourceKey="DangerBrush"/>
                                                        <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="White"/>
                                                    </MenuFlyoutItem.Resources>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="0" Grid.RowSpan="2" Background="#99000000"
                Visibility="{x:Bind Vm.IsExportPromptOpen, Mode=OneWay}">
            <Border Style="{StaticResource Card}" Padding="28" MaxWidth="440" Margin="32"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{x:Bind Vm.ExportPromptTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="The frame PNGs are copied into a subfolder you choose, alongside a manifest with a per-frame checksum."
                               Style="{StaticResource SubtleText}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <CheckBox Content="Compress to a single .7z (maximum compression)" FontSize="13"
                              IsChecked="{x:Bind Vm.CompressExport, Mode=TwoWay}" Margin="0,18,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0" Spacing="10">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                MinWidth="96" Command="{x:Bind Vm.CancelExportCommand}"/>
                        <Button Content="Export" Style="{StaticResource PrimaryButton}"
                                MinWidth="112" Command="{x:Bind Vm.ConfirmExportCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
