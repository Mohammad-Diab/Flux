<UserControl
    x:Class="FluxCast.Views.PresenterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- The number and Go live inside the frame pill, so both drop their own chrome and let the
             pill's border and fill be the only ones. WinUI restyles stock control states through named
             brushes rather than retemplating, hence the overrides on each. -->
        <Style x:Key="FramePillBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="FramePillButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0,7,7,0"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FF262A30" RowDefinitions="72,*,Auto">

        <!-- The bars follow the theme; only the area around the frame stays dark, to hold the
             viewer's eye and the capture's contrast on the frame itself. -->
        <Border Grid.Row="0" Background="{ThemeResource SurfaceBrush}">
            <!-- Next keeps its text label: the receiver's OCR locates that button by the word "Next". -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <Button Command="{x:Bind Vm.FirstCommand}" IsTabStop="False" AutomationProperties.Name="First frame"
                        ToolTipService.ToolTip="First frame"
                        Style="{StaticResource SecondaryButton}" MinWidth="50" Padding="0" MinHeight="44">
                    <FontIcon Glyph="&#xE892;" FontSize="15"/>
                </Button>
                <Button Command="{x:Bind Vm.BackCommand}" IsTabStop="False"
                        Style="{StaticResource SecondaryButton}" MinWidth="104" MinHeight="44">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE76B;" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Back" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Label, number, total and Go read as one control rather than four loose ones. -->
                <Border Height="44" CornerRadius="8" Margin="10,0,4,0"
                        Background="{ThemeResource SurfaceAltBrush}"
                        BorderBrush="{ThemeResource FluxBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Frame" FontSize="14" VerticalAlignment="Center" Margin="14,0,10,0"
                                   Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <TextBox Text="{x:Bind Vm.GotoText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FramePillBox}" Width="78" KeyDown="OnGotoKeyDown"
                                 AutomationProperties.Name="Frame number"
                                 ToolTipService.ToolTip="Go to frame number">
                            <TextBox.Resources>
                                <!-- The template's minimum height is what makes the box taller than its
                                     text, and a TextBox taller than its text pins the text to the top
                                     however it is told to align. Sized to its text, it centres. -->
                                <x:Double x:Key="TextControlThemeMinHeight">0</x:Double>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBlock Text="{x:Bind TotalLabel}" FontSize="14" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <Border Width="1" Margin="12,9,0,9" Background="{ThemeResource FluxBorderBrush}"/>
                        <Button Content="Go" Command="{x:Bind Vm.GotoCommand}" IsTabStop="False"
                                Style="{StaticResource FramePillButton}">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="HoverOverlayBrush"/>
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="HoverOverlayStrongBrush"/>
                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <Button Command="{x:Bind Vm.NextCommand}" IsTabStop="False" Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButton}" MinWidth="104" MinHeight="44">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Next" FontSize="16" VerticalAlignment="Center"/>
                        <!-- No Foreground of its own: it inherits the button's, so it follows the label
                             into the disabled colour instead of staying white and vanishing. -->
                        <FontIcon Glyph="&#xE76C;" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind Vm.LastCommand}" IsTabStop="False" AutomationProperties.Name="Last frame"
                        ToolTipService.ToolTip="Last frame"
                        Style="{StaticResource SecondaryButton}" MinWidth="50" Padding="0" MinHeight="44">
                    <FontIcon Glyph="&#xE893;" FontSize="15"/>
                </Button>
            </StackPanel>

        </Border>

        <!-- Sized in code-behind: the frame must land on whole device pixels, never be resampled.
             Stretch is Fill, not None: None draws the bitmap at its natural DIP size and lets Width
             and Height merely clip it, so above 100% scaling the frame is magnified and cut off. -->
        <Grid x:Name="FrameArea" Grid.Row="1" Margin="10">
            <!-- Holds the outgoing frame underneath while the incoming one decodes. Without it the
                 image is empty for that frame and the area blinks to its background on every step. -->
            <Image x:Name="FrameHold" Stretch="Fill" Visibility="Collapsed"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Image x:Name="FrameImage" Source="{x:Bind Vm.CurrentFrame, Mode=OneWay}" Stretch="Fill"
                   ImageOpened="OnFrameOpened" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Fixed height, so the warning appearing in here costs the frame nothing. -->
        <Border Grid.Row="2" Height="34" Background="{ThemeResource SurfaceBrush}">
          <Grid>
            <TextBlock Text="Keep this window still during transfer" FontSize="10.5"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextSecondaryBrush}"/>
            <!-- A pill rather than a bar: the warning is about the frame being short of room, so it
                 must not take any. It sits in the chrome, never over the frame, which the receiver
                 captures, and is laid over this row rather than in it, so a narrow window makes it
                 cover the note instead of squeezing it away. The whole pill is the button — a 22 px
                 circle is a small target for something the user is meant to notice and open. Click,
                 not hover: the pointer passes through here on its way to the transport buttons. -->
            <Button x:Name="SizeWarningButton" Visibility="Collapsed" Canvas.ZIndex="1"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                    Height="28" CornerRadius="14" Padding="14,0,4,0"
                    BorderThickness="1" BorderBrush="{StaticResource WarningBrush}"
                    Background="{ThemeResource SurfaceBrush}"
                    AutomationProperties.Name="Window size is too small"
                    ToolTipService.ToolTip="The frame is below native size — open for detail">
                <!-- Origin as a fraction; ScaleTransform's own centre is in pixels, not a ratio. -->
                <Button.RenderTransformOrigin>0.5,0.5</Button.RenderTransformOrigin>
                <Button.RenderTransform>
                    <ScaleTransform x:Name="SizeWarningScale"/>
                </Button.RenderTransform>
                <Button.Resources>
                    <StaticResource x:Key="ButtonBackground" ResourceKey="SurfaceBrush"/>
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SurfaceAltBrush"/>
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SurfaceAltBrush"/>
                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="WarningBrush"/>
                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="WarningBrush"/>
                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="WarningBrush"/>
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <!-- Divided into segments the way the frame counter is, so the label and the mark
                         read as two parts of one control rather than a badge with a caption. -->
                    <TextBlock x:Name="SizeWarningSummary" Text="Window size is too small"
                               VerticalAlignment="Center" FontSize="11"
                               Foreground="{ThemeResource TextPrimaryBrush}"/>
                    <Border Width="1" Margin="0,5" Opacity="0.55"
                            Background="{StaticResource WarningBrush}"/>
                    <Border Width="22" Height="22" CornerRadius="11" VerticalAlignment="Center"
                            Background="{StaticResource WarningBrush}">
                        <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="#FF2A1C00"/>
                    </Border>
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="Top" Opening="OnSizeWarningOpening">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}"/>
                                <Setter Property="BorderBrush" Value="{ThemeResource FluxBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="CornerRadius" Value="12"/>
                                <Setter Property="Padding" Value="18"/>
                                <Setter Property="MaxWidth" Value="400"/>
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <StackPanel Width="330" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="26" Height="26" CornerRadius="13"
                                        Background="{StaticResource WarningBrush}">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="#FF2A1C00"/>
                                </Border>
                                <TextBlock Text="Window is small" FontSize="16" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource SubtleText}"
                                       Text="The frame is drawn below its native size. Shrinking it blunts the tile edges the receiver reads, so a capture may need more retries or fail outright."/>
                            <!-- The numbers behind the warning, so it is not just an assertion. -->
                            <Border Background="{ThemeResource SurfaceAltBrush}" CornerRadius="8" Padding="11,9">
                                <TextBlock x:Name="SizeWarningDetail" TextWrapping="Wrap" FontSize="12"
                                           LineHeight="18"
                                           Foreground="{ThemeResource TextSecondaryBrush}"/>
                            </Border>
                            <Button Content="Got it" Click="OnDismissSizeWarning" HorizontalAlignment="Right"
                                    Style="{StaticResource SecondaryButton}" MinHeight="34" FontSize="13"/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
          </Grid>
        </Border>
    </Grid>
</UserControl>
