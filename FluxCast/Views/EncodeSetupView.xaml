<UserControl
    x:Class="FluxCast.Views.EncodeSetupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Flux.Ui.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <Grid MaxWidth="620" Margin="32,14,32,28" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="FluxCast" Style="{StaticResource BrandTitle}"/>
                <TextBlock Text="Turn a file or folder into frames for optical transfer."
                           Style="{StaticResource SubtleText}" FontSize="14" Margin="0,4,0,16"
                           HorizontalAlignment="Center" TextAlignment="Center"/>

                <Border Style="{StaticResource Card}" Padding="28">
                    <StackPanel>
                        <TextBlock Text="SOURCE" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextSecondaryBrush}" Margin="2,0,0,10"/>

                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <Grid Grid.Column="0" AllowDrop="True" Background="Transparent"
                                  DragOver="OnSourceDragOver" Drop="OnSourceDrop">
                                <TextBox Text="{x:Bind Vm.SelectedPath, Mode=OneWay}" IsReadOnly="True"/>
                                <TextBlock Text="Drop a file or folder here" IsHitTestVisible="False"
                                           Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           Margin="14,0,0,0" FontSize="13"
                                           Visibility="{x:Bind Empty(Vm.SelectedPath), Mode=OneWay}"/>
                            </Grid>
                            <Button Grid.Column="1" Content="File…" Command="{x:Bind Vm.PickFileCommand}"
                                    Style="{StaticResource SecondaryButton}" MinWidth="104" Margin="8,0,0,0"/>
                            <Button Grid.Column="2" Content="Folder…" Command="{x:Bind Vm.PickFolderCommand}"
                                    Style="{StaticResource SecondaryButton}" MinWidth="104" Margin="8,0,0,0"/>
                        </Grid>

                        <TextBlock Text="{x:Bind Vm.SourceSummary, Mode=OneWay}" Margin="2,8,0,0" FontSize="13"
                                   TextWrapping="Wrap" Foreground="{x:Bind SummaryBrush(Vm.SourceInfo), Mode=OneWay}"/>
                        <TextBlock Text="Measuring…" Style="{StaticResource SubtleText}" FontSize="13" Margin="2,4,0,0"
                                   Visibility="{x:Bind Vm.IsValidating, Mode=OneWay}"/>

                        <Border Background="{ThemeResource SurfaceAltBrush}" BorderBrush="{ThemeResource FluxBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,10,0,0"
                                Visibility="{x:Bind Filled(Vm.SourceDetails), Mode=OneWay}">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Vm.SourceDetails, Mode=OneWay}" FontSize="12"
                                           Foreground="{ThemeResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind Vm.EstimatedFrames, Mode=OneWay}" FontSize="12"
                                           Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="ENCODING MODE" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextSecondaryBrush}" Margin="2,24,0,10"/>
                        <Border Background="{ThemeResource SurfaceAltBrush}" BorderBrush="{ThemeResource FluxBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="3">
                            <controls:SlidingTabBar Stretch="True" PillCornerRadius="7">
                                <RadioButton Content="Default" GroupName="SetupMode" Style="{StaticResource SegmentToggle}"
                                             IsChecked="{x:Bind Vm.IsDefaultMode, Mode=TwoWay}"
                                             ToolTipService.ToolTip="Recommended settings for a clean channel"/>
                                <RadioButton Content="Rugged" GroupName="SetupMode" Style="{StaticResource SegmentToggle}"
                                             IsChecked="{x:Bind Vm.IsRuggedMode, Mode=TwoWay}"
                                             ToolTipService.ToolTip="Robust preset for RDP / lossy channels"/>
                                <RadioButton Content="Advanced" GroupName="SetupMode" Style="{StaticResource SegmentToggle}"
                                             IsChecked="{x:Bind Vm.IsAdvancedMode, Mode=TwoWay}"
                                             ToolTipService.ToolTip="Customise error correction, tile size, palette, and compression"/>
                            </controls:SlidingTabBar>
                        </Border>

                        <controls:RevealHost IsOpen="{x:Bind Vm.IsAdvanced, Mode=OneWay}">
                            <StackPanel>
                                <TextBlock Text="ERROR CORRECTION" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextSecondaryBrush}" Margin="2,24,0,10"/>
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind Vm.EccLevels}"
                                          SelectedItem="{x:Bind Vm.SelectedEccLevel, Mode=TwoWay}"/>

                                <TextBlock Text="TRANSFER SPEED" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextSecondaryBrush}" Margin="2,24,0,10"/>
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind Vm.TileSizes}"
                                          SelectedItem="{x:Bind Vm.SelectedTileSize, Mode=TwoWay}"/>
                                <ComboBox HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                          ItemsSource="{x:Bind Vm.AvailableColors, Mode=OneWay}"
                                          SelectedItem="{x:Bind Vm.SelectedColor, Mode=TwoWay}"/>

                                <CheckBox Content="Compress with 7-Zip (folders are always compressed)" FontSize="13"
                                          IsChecked="{x:Bind Vm.Compress, Mode=TwoWay}" Margin="2,16,0,0"
                                          IsEnabled="{x:Bind Unlocked(Vm.CompressLocked), Mode=OneWay}"/>
                            </StackPanel>
                        </controls:RevealHost>

                        <TextBlock Text="{x:Bind Vm.GridSummary, Mode=OneWay}" FontSize="12"
                                   Foreground="{StaticResource AccentBrush}" Margin="2,16,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind Vm.GridCaution, Mode=OneWay}" FontSize="12" Margin="2,4,0,0"
                                   TextWrapping="Wrap" Foreground="{x:Bind CautionBrush(Vm.WarningLevel), Mode=OneWay}"/>

                        <Button Content="Start encoding" Command="{x:Bind Vm.StartCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,24,0,0"/>
                        <Button Content="Test frame on this channel" Command="{x:Bind Vm.TestFrameCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                                ToolTipService.ToolTip="Render one frame at these settings to capture in FluxRead before a full transfer"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
