<UserControl
    x:Class="FluxCast.WinUI.Views.EncodeProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Flux.Ui.WinUI.Controls">

    <Grid MaxWidth="580" Margin="32" VerticalAlignment="Center">
        <Border Style="{StaticResource Card}" Padding="28">
            <StackPanel>
                <TextBlock Text="{x:Bind Vm.PhaseText, Mode=OneWay}" Style="{StaticResource HeadingText}"/>

                <!-- ReadoutBar for the determinate case: the stock ProgressBar's track height is baked in. -->
                <controls:ReadoutBar Height="8" Margin="0,20,0,10" BarCornerRadius="4"
                                     Fraction="{x:Bind Vm.ProgressValue, Mode=OneWay}"
                                     TrackBrush="{ThemeResource SurfaceAltBrush}"
                                     FillBrush="{StaticResource AccentGradientHorizontal}"
                                     Visibility="{x:Bind Determinate(Vm.IsIndeterminate), Mode=OneWay}"/>
                <ProgressBar Margin="0,20,0,10" IsIndeterminate="True"
                             Visibility="{x:Bind Vm.IsIndeterminate, Mode=OneWay}"/>

                <TextBlock Text="{x:Bind Vm.DetailText, Mode=OneWay}" Style="{StaticResource SubtleText}"
                           TextWrapping="Wrap"/>

                <TextBlock Text="{x:Bind Vm.ErrorText, Mode=OneWay}" FontSize="13"
                           Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,16,0,0"
                           Visibility="{x:Bind Filled(Vm.ErrorText), Mode=OneWay}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0" Spacing="8">
                    <Button Content="Back" Command="{x:Bind Vm.AcknowledgeErrorCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Visibility="{x:Bind Filled(Vm.ErrorText), Mode=OneWay}"/>
                    <Button Content="Cancel" Command="{x:Bind Vm.CancelCommand}"
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
