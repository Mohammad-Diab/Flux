<Window
    x:Class="FluxCast.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Flux.Ui.WinUI.Controls"
    xmlns:views="using:Flux.Ui.WinUI.Views">

    <Grid Background="{ThemeResource BgBrush}" RowDefinitions="48,Auto,*">

        <views:AmbientBackground x:Name="Ambient" Grid.RowSpan="3"/>

        <!-- SetTitleBar takes this as the drag region, replacing WPF's WindowChrome. -->
        <Grid x:Name="TitleBarStrip" Grid.Row="0" Padding="16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AccentGradient}"/>
                <TextBlock Text="FluxCast" Style="{StaticResource BrandTitle}" FontSize="13"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Optical sender · WinUI" FontSize="12"
                           Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <!-- Clear of the native caption buttons, which own the right edge of the drag region. -->
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,148,0">
                <Button x:Name="BackButton" Content="Back" Style="{StaticResource SecondaryButton}"
                        MinHeight="30" Padding="12,0" FontSize="12" Visibility="Collapsed"
                        Click="OnBack"/>
                <Button x:Name="SettingsButton" Content="Settings" Style="{StaticResource SecondaryButton}"
                        MinHeight="30" Padding="12,0" FontSize="12" Click="OnOpenSettings"/>
            </StackPanel>
        </Grid>

        <Border x:Name="TabStrip" Grid.Row="1" Padding="24,8,24,2">
            <controls:SlidingTabBar x:Name="TabBar" HorizontalAlignment="Left">
                <RadioButton x:Name="CastTab" Content="Cast" GroupName="Tab"
                             Style="{StaticResource TabRadio}" IsChecked="True" Checked="OnTabChanged"/>
                <RadioButton x:Name="HistoryTab" Content="History" GroupName="Tab"
                             Style="{StaticResource TabRadio}" Checked="OnTabChanged"/>
            </controls:SlidingTabBar>
        </Border>

        <controls:TransitionHost x:Name="ContentHost" Grid.Row="2"/>
    </Grid>
</Window>
